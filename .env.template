# wingman-x configuration template.
#
# Copy this file to .env (gitignored) and edit values to match your machine.
# For secondary overrides, also supported: .env.local (loaded first, wins on
# conflict). Real process env always beats both.
#
# Loader: scripts/load-env.mjs — imported by packages/daemon/bin/dev.ts and
# every env-reading script under packages/agent-kit/scripts/.

# ---------------------------------------------------------------- Daemon ---

# Initial port the daemon tries. Auto-bumps up to 53836 on conflict.
PORT=53827

# Directory where the daemon persists state.json and reads the KB from.
# WINGMAN_X_STATE_DIR=~/.wingman-x

# Comma-separated Chrome extension IDs allowed by CORS. When set, requests
# from any other origin are 403'd. Recommended on shared dev machines.
# WINGMAN_X_EXT_ALLOWED_IDS=abcdefghijklmnopqrstuvwxyzabcdef

# -------------------------------------- Agent-kit: CDP + scrape bounds ---

# Playwright connects here to attach to your logged-in Chrome.
# Launch Chrome with the matching port via: npm run launch-chrome
CDP_URL=http://127.0.0.1:9223

# Bounded scroll window (keep conservative — see failure mode #2 in
# docs/agent-workflow.md for why no auto-retry inside a single run).
# MAX_TWEETS=20
# MAX_SCROLLS=20
# SCROLL_DELAY=900

# -------------------------------------- Chrome launch helper (bash) ---
#
# Consumed by scripts/launch-chrome.sh ("npm run launch-chrome"). Must stay
# consistent with CDP_URL above (same port).

CHROME_REMOTE_DEBUGGING_PORT=9223

# Persistent user-data directory — this is where your Twitter login cookies
# live. Do NOT point this at your default Chrome profile, use a dedicated
# one so twitter.com's session doesn't collide with your regular browsing.
# NOTE: double-quote so bash's `source` (used by scripts/launch-chrome.sh)
# expands $HOME; scripts/load-env.mjs also expands leading $HOME / ~ for JS
# consumers.
CHROME_PROFILE_DIR="$HOME/.wingman-x/chrome-profile"

# Agent watcher limits.
# WATCHER_DRAFT_TIMEOUT_MS=60000
# WATCHER_SCRAPE_TIMEOUT_MS=60000
# WATCHER_FETCH_TIMEOUT_MS=10000

# Path to the Chrome/Chromium binary. Quote values with spaces so both
# bash and dotenv parse them as a single token.
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome          (or /usr/bin/chromium)
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# ------------------------------------------------- Chime In (npm run scan) ---
#
# Ingestion. Get a token at https://console.apify.com/account/integrations.
# APIFY_TOKEN=apify_api_...
# Actor id. Verified 2026-09-04:
#   delicious_zebu/ultimate-x-twitter-advanced-search-scraper — recent posts,
#     $0.0004/result, no per-query fee, works on the Apify free plan. Default.
#   apidojo/twitter-scraper-lite — recent posts, ~$0.02/query, but the free
#     Apify plan caps every run at 10 items (needs Starter, $19/mo).
#   Avoid feedminer/x-tweet-scraper, xtracto/x-account-tweets-scraper,
#     studio-amba/twitter-feed-scraper: anonymous mode returns only each
#     account's all-time top posts, never a recent timeline.
# APIFY_ACTOR=delicious_zebu/ultimate-x-twitter-advanced-search-scraper
# "search" (default) batches handles into from: OR queries with since: and
# excludes replies/reposts server-side (~6 queries per 64 handles). "handles"
# scrapes each profile timeline (one query per handle) as a fallback.
# APIFY_MODE=search
# APIFY_HANDLES_PER_QUERY=12
# MAX_POSTS_PER_ACCOUNT=10
# INCLUDE_REPLIES=false
# INCLUDE_REPOSTS=false
# SCAN_LOOKBACK_HOURS=36

# Thresholds (0-100). Start strict; loosen from scan reports in
# ~/.wingman-x/chime-in/scans/.
# THEME_THRESHOLD=60
# EXPERTISE_THRESHOLD=70
# CONTRIBUTION_THRESHOLD=70
# MAX_CANDIDATES_PER_SCAN=0          # 0 = no cap (default); set a number to cap drafted candidates per scan
# DRAFT_VARIANTS=1           # drafts per candidate; set 2-5 to pre-draft alternates served on ♻️ without a model call
# CONVERSATIONAL_THEMES=Technology and startups,General and internet culture
# CONVERSATIONAL_STRICT_THEMES=General and internet culture
# CONVERSATIONAL_THRESHOLD=80
# MAX_CONVERSATIONAL_CANDIDATES=40
# --- Telegram surface (watch mode): one message per card with Open in X / Regenerate / Posted / Dismiss
# TELEGRAM_BOT_TOKEN=123456:ABC...      # from @BotFather
# TELEGRAM_CHAT_ID=123456789            # your chat with the bot (send it a message, then read getUpdates)
# TELEGRAM_QUIET_HOURS=23-8             # hold cards overnight; empty = deliver always
# TELEGRAM_TZ=America/Chicago
# PRIORITY_BOOST=5

# Model host: auto | claude-cli | codex-cli | anthropic. "auto" picks the
# Anthropic API if ANTHROPIC_API_KEY is set, else the claude CLI, else codex.
# LLM_PROVIDER=auto
# LLM_MODEL_CHEAP=haiku        # theme classification
# LLM_MODEL_STRONG=sonnet      # expertise + contribution scoring
# LLM_MODEL_DRAFT=sonnet       # reply drafting (try opus for quality)
# LLM_CONCURRENCY=3
# ANTHROPIC_API_KEY=

# Where Chime In keeps its watchlist, processed log and scan reports.
# CHIME_IN_DIR=~/.wingman-x/chime-in
